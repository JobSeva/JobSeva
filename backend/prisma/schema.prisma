generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String          @id @default(uuid())
  name              String
  email             String          @unique
  role              String
  passwordHash      String
  status            String          @default("active")
  isVerified        Boolean         @default(false)
  verificationToken String?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  profileCompletion Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  applications      Application[]
  companyProfile    CompanyProfile?
  courses           Course[]        @relation("NgoCourses")
  enrollments       Enrollment[]
  receivedMessages  Message[]       @relation("ReceivedMessages")
  sentMessages      Message[]       @relation("SentMessages")
  seekerProfileViewsGiven    SeekerProfileView[] @relation("SeekerProfileViewsGiven")
  seekerProfileViewsReceived SeekerProfileView[] @relation("SeekerProfileViewsReceived")
  ngoProfile        NgoProfile?
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  savedJobs         SavedJob[]
  seekerProfile     SeekerProfile?
  settings          UserSettings?
}

model Course {
  id            String       @id @default(uuid())
  title         String
  description   String
  duration      String
  mode          String
  category      String
  image         String       @default("")
  location      String       @default("")
  contactNumber String       @default("")
  rating        Float        @default(0)
  status        String       @default("active")
  ngoId         String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  ngo           User         @relation("NgoCourses", fields: [ngoId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model UserSettings {
  id                 String  @id @default(uuid())
  userId             String  @unique
  emailNotifications Boolean @default(true)
  marketingEmails    Boolean @default(false)
  darkMode           Boolean @default(false)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SeekerProfile {
  userId          String             @id
  headline        String             @default("")
  bio             String             @default("")
  location        String             @default("")
  phone           String             @default("")
  avatarUrl       String?
  skillsRaw       String             @default("[]")
  languagesRaw    String             @default("[]")
  resumeUrl       String?
  resumeFileName  String?
  linkedinUrl     String?
  githubUrl       String?
  portfolioUrl    String?
  profileStrength Int                @default(0)
  updatedAt       DateTime           @updatedAt
  experiences     SeekerExperience[]
  education       SeekerEducation[]
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SeekerEducation {
  id              String        @id @default(uuid())
  seekerProfileId String
  school          String
  degree          String
  field           String
  startYear       Int           @default(2020)
  endYear         Int           @default(2024)
  grade           String?
  period          String?
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [userId], onDelete: Cascade)
}

model SeekerExperience {
  id              String        @id @default(uuid())
  seekerProfileId String
  title           String
  company         String
  startDate       String        @default("")
  endDate         String        @default("")
  description     String?
  period          String?
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [userId], onDelete: Cascade)
}

model CompanyProfile {
  companyId            String   @id @default(uuid())
  ownerUserId          String   @unique
  name                 String
  logo                 String   @default("")
  tagline              String   @default("")
  about                String   @default("")
  industry             String   @default("")
  size                 String   @default("")
  founded              Int      @default(0)
  headquarters         String   @default("")
  website              String   @default("")
  email                String   @default("")
  phone                String   @default("")
  linkedin             String?
  twitter              String?
  instagram            String?
  recruiterName        String   @default("")
  recruiterDesignation String   @default("")
  isHiring             Boolean  @default(true)
  openPositions        Int      @default(0)
  onboardingCompleted  Boolean  @default(false)
  updatedAt            DateTime @updatedAt
  ownerUser            User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  jobs                 Job[]
}

model NgoProfile {
  userId          String   @id
  description     String   @default("")
  tagline         String   @default("")
  location        String   @default("")
  phone           String   @default("")
  email           String   @default("")
  website         String   @default("")
  logoUrl         String?
  foundingYear    Int      @default(0)
  size            String   @default("")
  linkedin        String?
  twitter         String?
  instagram       String?
  profileStrength Int      @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id                  String         @id @default(uuid())
  title               String
  companyId           String
  location            String
  salaryMin           Int
  salaryMax           Int
  type                String
  remote              Boolean        @default(false)
  skillsRaw           String         @default("[]")
  description         String
  responsibilitiesRaw String         @default("[]")
  applicantsCount     Int            @default(0)
  postedAt            DateTime       @default(now())
  active              Boolean        @default(true)
  education           String?
  experience          String?
  workMode            String?
  openings            Int            @default(1)
  deadline            DateTime?
  applications        Application[]
  company             CompanyProfile @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  savedBy             SavedJob[]
}

model Application {
  id              String   @id @default(uuid())
  seekerId        String
  jobId           String
  jobTitle        String
  company         String
  companyLogo     String
  status          String   @default("applied")
  resumeUrl       String?
  appliedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  matchScore      Int      @default(0)
  recruiterRating Float?
  recruiterNote   String?
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker          User     @relation(fields: [seekerId], references: [id], onDelete: Cascade)
}

model SavedJob {
  id       String   @id @default(uuid())
  seekerId String
  jobId    String
  savedAt  DateTime @default(now())
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker   User     @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([seekerId, jobId])
}

model Message {
  id            String   @id @default(uuid())
  senderId      String
  receiverId    String
  applicationId String?
  content       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  receiver      User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SeekerProfileView {
  id          String   @id @default(uuid())
  seekerUserId String
  viewerUserId String
  viewerRole  String
  viewedAt    DateTime @default(now())
  seekerUser  User     @relation("SeekerProfileViewsReceived", fields: [seekerUserId], references: [id], onDelete: Cascade)
  viewerUser  User     @relation("SeekerProfileViewsGiven", fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@index([seekerUserId, viewedAt])
  @@index([viewerUserId, viewedAt])
}
